# Set this on the backend only to enable the AI assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# GitHub App user authorization. Configure the App callback URL to match this URL.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=
# Set GITHUB_APP_PRIVATE_KEY_PEM with literal \\n sequences, or use a protected key file.
GITHUB_APP_PRIVATE_KEY_PEM=
GITHUB_CALLBACK_URL=http://localhost:8000/api/github/auth/callback
GITHUB_FRONTEND_URL=http://localhost:3000
TRACERPYX_FRONTEND_ORIGIN=http://localhost:3000
GITHUB_COOKIE_SECURE=false
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TRACERPYX_GITHUB_ENCRYPTION_KEY=
# Set TRACERPYX_DB_PATH to a durable protected location for deployments.
TRACERPYX_DB_PATH=
